---
const reasons = [
	{
		title: 'Quality you can feel',
		text: 'Choose your fabric and GSM. We help you pick what suits the occasion and your budget.',
	},
	{
		title: 'Bulk pricing',
		text: 'Better per-piece rates as your quantity grows, with a clear quote before you commit.',
	},
	{
		title: 'On-time delivery',
		text: 'We agree a delivery date before production starts and keep you updated until it arrives.',
	},
	{
		title: 'Design help',
		text: 'Send us your logo and we will prepare the artwork and share a mockup before printing.',
	},
];
---

<section id="why-us" class="bg-slate-50 py-20">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<h2 class="text-3xl font-bold text-navy sm:text-4xl">Why businesses choose us</h2>
		<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{
				reasons.map((reason) => (
					<div class="rounded-2xl border border-slate-200 bg-white p-6">
						<div class="h-1 w-10 rounded-full bg-accent" />
						<h3 class="mt-4 text-lg font-semibold text-navy">{reason.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-600">{reason.text}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
