---
import { Image, getImage } from 'astro:assets';
import corporatePolo from '../assets/gallery/corporate-polo-uniforms.png';
import teamTshirts from '../assets/gallery/team-tshirts-names-numbers.png';
import staffUniforms from '../assets/gallery/staff-factory-uniforms.png';
import embroidery from '../assets/gallery/embroidery-showcase.png';
import eventTshirts from '../assets/gallery/event-tshirts-dtf.png';

const samples = [
	{
		image: corporatePolo,
		title: 'Corporate polo T-shirts',
		detail: 'Embroidered chest logo, six colour options',
		alt: 'Navy corporate polo T-shirts with an embroidered chest logo, worn by office staff',
	},
	{
		image: staffUniforms,
		title: 'Staff & factory uniforms',
		detail: 'T-shirts, polos, shirts, trousers and workwear',
		alt: 'Custom staff and factory uniforms including polos, work overalls and formal shirts',
	},
	{
		image: embroidery,
		title: 'Embroidery',
		detail: 'Polos, hoodies, sweatshirts and jackets',
		alt: 'Embroidered logos on hoodies, sweatshirts, polos and zipper jackets',
	},
	{
		image: teamTshirts,
		title: 'Team T-shirts',
		detail: 'Custom names & numbers, full-colour print',
		alt: 'Sports team jerseys printed with custom player names and numbers',
	},
	{
		image: eventTshirts,
		title: 'Event T-shirts',
		detail: 'Full-colour DTF print for fests and promotions',
		alt: 'Event T-shirts with colourful full-colour DTF printed designs',
	},
];

const items = await Promise.all(
	samples.map(async (sample) => ({
		...sample,
		fullSize: await getImage({ src: sample.image, width: 1536, format: 'webp' }),
	})),
);
---

<section id="work" class="py-20">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<h2 class="text-3xl font-bold text-navy sm:text-4xl">What we make</h2>
		<p class="mt-3 max-w-2xl text-slate-600">
			T-shirts, polos and uniforms for offices, events and teams. Tap any image to see it full size.
		</p>
		<div class="mt-10 grid gap-6 md:grid-cols-2">
			{
				items.map((item, i) => (
					<figure class:list={['overflow-hidden rounded-2xl border border-slate-200 bg-white', i === 0 && 'md:col-span-2']}>
						<a href={item.fullSize.src} target="_blank" rel="noopener" class="block">
							<Image
								src={item.image}
								alt={item.alt}
								widths={i === 0 ? [640, 1152, 1536] : [480, 768, 1152]}
								sizes={i === 0 ? '(min-width: 1152px) 1152px, 100vw' : '(min-width: 768px) 50vw, 100vw'}
								loading={i === 0 ? 'eager' : 'lazy'}
								class="h-auto w-full"
							/>
						</a>
						<figcaption class="p-4">
							<p class="font-semibold text-navy">{item.title}</p>
							<p class="text-sm text-slate-500">{item.detail}</p>
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>
