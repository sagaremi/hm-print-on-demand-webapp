---
// Placeholder tiles until real photos are added in Step 6
const samples = [
	{ title: 'Corporate T-shirts', detail: 'Screen printed logo' },
	{ title: 'Polo T-shirts', detail: 'Embroidered chest logo' },
	{ title: 'Uniforms', detail: 'Staff & factory wear' },
	{ title: 'Event T-shirts', detail: 'Full-colour DTF print' },
	{ title: 'Embroidery', detail: 'Close-up detail' },
	{ title: 'Team T-shirts', detail: 'Names & numbers' },
];
---

<section id="work" class="py-20">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<h2 class="text-3xl font-bold text-navy sm:text-4xl">Our work</h2>
		<p class="mt-3 max-w-2xl text-slate-600">A few recent orders for offices, events and teams.</p>
		<div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3">
			{
				samples.map((sample) => (
					<figure class="overflow-hidden rounded-2xl border border-slate-200">
						<div class="flex aspect-square items-center justify-center bg-slate-100 text-sm text-slate-400">
							Photo coming soon
						</div>
						<figcaption class="p-4">
							<p class="font-semibold text-navy">{sample.title}</p>
							<p class="text-sm text-slate-500">{sample.detail}</p>
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>
