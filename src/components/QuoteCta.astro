---
import { whatsappLink, emailLink } from '../config/site';
---

<section id="quote" class="bg-accent py-20">
	<div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
		<h2 class="text-3xl font-bold text-navy sm:text-4xl">Get a quote for your order</h2>
		<p class="mt-4 text-lg text-navy/80">
			Tell us the product, quantity and print type, and we will reply with a price.
		</p>
		<div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
			<a
				href={whatsappLink()}
				target="_blank"
				rel="noopener"
				class="rounded-full bg-navy px-7 py-3.5 font-semibold text-white transition hover:bg-navy-light"
			>
				Chat on WhatsApp
			</a>
			<a
				href={emailLink()}
				class="rounded-full border-2 border-navy px-7 py-3.5 font-semibold text-navy transition hover:bg-navy/10"
			>
				Email us
			</a>
		</div>
		<p class="mt-6 text-sm text-navy/70">We reply within a few hours · No spam</p>
	</div>
</section>
