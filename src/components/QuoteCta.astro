---
import { site, whatsappLink, emailLink } from '../config/site';

const formAction = 'https://api.web3forms.com/submit';
const thankYouUrl = new URL('/thank-you', Astro.site).href;
const input =
	'mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-3 text-slate-900 focus:border-navy focus:outline-none';
const label = 'text-sm font-semibold text-navy';
const phonePattern = '[0-9+\\-\\s]{10,16}';
---

<section id="quote" class="py-20">
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<h2 class="text-3xl font-bold text-navy sm:text-4xl">Get a quote for your order</h2>
		<p class="mt-3 max-w-2xl text-slate-600">Choose whatever is easiest for you. We reply within a few hours.</p>

		<div class="mt-10 grid gap-6 lg:grid-cols-5">
			<form
				data-lead-form
				action={formAction}
				method="POST"
				class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 lg:col-span-3"
			>
				<h3 class="text-xl font-bold text-navy">Send us your requirement</h3>
				<p class="mt-1 text-sm text-slate-500">We'll email you a quote. Phone number is optional.</p>

				<input type="hidden" name="access_key" value={site.web3formsAccessKey} />
				<input type="hidden" name="subject" value="New quote request from hoodmeta.store" />
				<input type="hidden" name="from_name" value="HoodMeta website" />
				<input type="hidden" name="request_type" value="Quote request" />
				<input type="hidden" name="estimate" id="lead-estimate" value="" />
				<input type="hidden" name="redirect" value={thankYouUrl} />
				<input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

				<div class="mt-6 grid gap-5 sm:grid-cols-2">
					<label class="block">
						<span class={label}>Name</span>
						<input name="name" required autocomplete="name" class={input} />
					</label>
					<label class="block">
						<span class={label}>Email</span>
						<input name="email" type="email" required autocomplete="email" class={input} />
					</label>
					<label class="block">
						<span class={label}>Company <span class="font-normal text-slate-400">(optional)</span></span>
						<input name="company" autocomplete="organization" class={input} />
					</label>
					<label class="block">
						<span class={label}>Phone / WhatsApp <span class="font-normal text-slate-400">(optional)</span></span>
						<input
							name="phone"
							type="tel"
							inputmode="tel"
							autocomplete="tel"
							pattern={phonePattern}
							title="Please enter a valid phone number"
							class={input}
						/>
					</label>
				</div>
				<label class="mt-5 block">
					<span class={label}>What do you need?</span>
					<textarea
						name="message"
						required
						rows="4"
						placeholder="e.g. 150 navy polo T-shirts with our logo embroidered on the chest, needed by 15th Dec"
						class={input}></textarea>
				</label>

				<button
					type="submit"
					class="mt-6 w-full rounded-full bg-accent px-7 py-3.5 font-semibold text-navy transition hover:bg-accent-dark disabled:opacity-60 sm:w-auto"
				>
					Send requirement
				</button>
				<p data-status class="mt-3 hidden text-sm" role="alert"></p>
				<p class="mt-4 text-xs text-slate-500">
					No spam. We only use your details to reply to this request. Prefer email?{' '}
					<a href={emailLink()} class="underline hover:text-navy">{site.email}</a>
				</p>
			</form>

			<div class="flex flex-col gap-6 lg:col-span-2">
				<div class="rounded-2xl bg-whatsapp/10 p-6 sm:p-8">
					<h3 class="text-xl font-bold text-navy">Chat on WhatsApp</h3>
					<p class="mt-1 text-sm text-slate-600">Quickest way to ask a question or share your logo.</p>
					<a
						href={whatsappLink()}
						target="_blank"
						rel="noopener"
						class="mt-5 inline-block rounded-full bg-whatsapp px-6 py-3 font-semibold text-white transition hover:opacity-90"
					>
						Open WhatsApp
					</a>
				</div>

				<form data-lead-form action={formAction} method="POST" class="rounded-2xl bg-slate-50 p-6 sm:p-8">
					<h3 class="text-xl font-bold text-navy">Request a callback</h3>
					<p class="mt-1 text-sm text-slate-600">Leave your number and we'll call you.</p>

					<input type="hidden" name="access_key" value={site.web3formsAccessKey} />
					<input type="hidden" name="subject" value="Callback request from hoodmeta.store" />
					<input type="hidden" name="from_name" value="HoodMeta website" />
					<input type="hidden" name="request_type" value="Callback request" />
					<input type="hidden" name="redirect" value={thankYouUrl} />
					<input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

					<label class="mt-5 block">
						<span class={label}>Name</span>
						<input name="name" required autocomplete="name" class={input} />
					</label>
					<label class="mt-4 block">
						<span class={label}>Phone</span>
						<input
							name="phone"
							type="tel"
							inputmode="tel"
							required
							autocomplete="tel"
							pattern={phonePattern}
							title="Please enter a valid phone number"
							class={input}
						/>
					</label>
					<button
						type="submit"
						class="mt-5 w-full rounded-full border-2 border-navy px-6 py-3 font-semibold text-navy transition hover:bg-navy/10 disabled:opacity-60"
					>
						Call me back
					</button>
					<p data-status class="mt-3 hidden text-sm" role="alert"></p>
				</form>
			</div>
		</div>
	</div>
</section>

<script>
	import { whatsappLink } from '../config/site';

	document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
		const status = form.querySelector<HTMLElement>('[data-status]')!;

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			const data = Object.fromEntries(new FormData(form));
			// The redirect field is only for the no-JavaScript fallback
			delete data.redirect;

			const buttonText = button.textContent;
			button.disabled = true;
			button.textContent = 'Sending…';
			status.classList.add('hidden');

			try {
				const response = await fetch(form.action, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify(data),
				});
				const result = await response.json();
				if (!result.success) throw new Error(result.message);
				window.location.href = '/thank-you';
			} catch {
				status.innerHTML = `Sorry, that didn't go through. Please try again or <a class="underline" href="${whatsappLink()}" target="_blank" rel="noopener">message us on WhatsApp</a>.`;
				status.className = 'mt-3 text-sm text-red-600';
				button.disabled = false;
				button.textContent = buttonText;
			}
		});
	});
</script>
