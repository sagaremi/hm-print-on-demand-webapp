---
import { site, whatsappLink } from '../config/site';

const highlights = ['T-shirts, polos & uniforms', 'Screen print · Embroidery · DTF', 'Delivery across India'];
---

<section class="bg-navy text-white">
	<div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
		<p class="text-sm font-semibold tracking-wide text-accent uppercase">For offices, events & teams</p>
		<h1 class="mt-4 max-w-3xl text-4xl leading-tight font-extrabold sm:text-6xl">
			Custom Corporate <span class="whitespace-nowrap">T-Shirts,</span> Printed &amp; Delivered
		</h1>
		<p class="mt-6 max-w-2xl text-lg text-slate-300">
			Branded T-shirts, polos and uniforms in bulk for businesses across {site.regions}.
		</p>
		<div class="mt-10 flex flex-col gap-3 sm:flex-row">
			<a
				href="#estimator"
				class="rounded-full bg-accent px-7 py-3.5 text-center font-semibold text-navy transition hover:bg-accent-dark"
			>
				Get an instant price
			</a>
			<a
				href={whatsappLink()}
				target="_blank"
				rel="noopener"
				class="rounded-full border border-white/30 px-7 py-3.5 text-center font-semibold transition hover:bg-white/10"
			>
				Chat on WhatsApp
			</a>
		</div>
		<ul class="mt-12 flex flex-wrap gap-x-8 gap-y-3 text-sm text-slate-300">
			{
				highlights.map((item) => (
					<li class="flex items-center gap-2">
						<span class="h-1.5 w-1.5 rounded-full bg-accent" />
						{item}
					</li>
				))
			}
		</ul>
	</div>
</section>
