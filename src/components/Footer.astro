---
import { site, whatsappLink, emailLink } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="bg-navy text-slate-300">
	<div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-3">
		<div>
			<p class="text-xl font-extrabold text-white">{site.name}</p>
			<p class="mt-2 text-sm">{site.tagline}.</p>
		</div>
		<div>
			<p class="text-sm font-semibold tracking-wide text-white uppercase">Contact</p>
			<ul class="mt-3 space-y-2 text-sm">
				<li><a href={whatsappLink()} target="_blank" rel="noopener" class="hover:text-white">WhatsApp: {site.phoneDisplay}</a></li>
				<li><a href={emailLink()} class="hover:text-white">{site.email}</a></li>
			</ul>
		</div>
		<div>
			<p class="text-sm font-semibold tracking-wide text-white uppercase">We serve</p>
			<p class="mt-3 text-sm">{site.regions}, with delivery across India.</p>
		</div>
	</div>
	<div class="border-t border-white/10 py-6 text-center text-xs text-slate-400">
		© {year} {site.name}. All rights reserved.
	</div>
</footer>
